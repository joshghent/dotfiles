#!/bin/bash
# Regenerate chezmoi's skills.yaml from the lock file `npx skills` maintains.
# Run by launchd whenever ~/.agents changes (see the sync-skills-manifest plist).
set -euo pipefail

lock="$HOME/.agents/.skill-lock.json"
manifest="$HOME/.local/share/chezmoi/.chezmoidata/skills.yaml"

[ -f "$lock" ] || exit 0

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

{
  cat <<'HEADER'
# Agent skills installed with `npx skills add --global`.
# Generated by ~/.local/bin/sync_skills_manifest from ~/.agents/.skill-lock.json.
# `chezmoi apply` reinstalls any that are missing on a new machine.
skills:
HEADER
  jq -r '.skills | to_entries | group_by(.value.source)[]
    | "  - source: \(.[0].value.source)\n    names:\n"
      + (map("      - \(.key)") | sort | join("\n"))' "$lock"
} > "$tmp"

if ! cmp -s "$tmp" "$manifest"; then
  cat "$tmp" > "$manifest"
  echo "updated $manifest"
fi
