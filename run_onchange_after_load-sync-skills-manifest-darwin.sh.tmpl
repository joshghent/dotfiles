#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
# plist hash: {{ include "Library/LaunchAgents/com.joshghent.sync-skills-manifest.plist.tmpl" | sha256sum }}
set -e

plist="$HOME/Library/LaunchAgents/com.joshghent.sync-skills-manifest.plist"
launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
{{ end -}}
